# Isolated configuration for the deterministic, non-biological smoke-test data.
SAMPLES_TSV="test_data/samples.tsv"
RAW_DIR="test_data/fastq"
REFERENCE="test_data/reference/synthetic_reference.fna"
TARGETS="test_data/reference/synthetic.targets.tsv.gz"
POPULATION_PANEL="test_data/reference/synthetic_population_panel.tsv.gz"

PROCESSED_DIR="test_runs/processed"
OUTPUT_DIR="test_runs/results"
PLOTS_DIR="plots"
THREADS=2

TRIM_QUALITY=30
MIN_READ_LENGTH=75
ADAPTER_R1=""
ADAPTER_R2=""
MIN_MAPQ=30
MIN_BASEQ=20
MAX_DEPTH=100000

# Exercise the optional FreeBayes branch when this fixture is run.
RUN_FREEBAYES=1
FREEBAYES_PLOIDY=1
FREEBAYES_MIN_ALT_COUNT=2
FREEBAYES_MIN_ALT_FRACTION=0.2

POPULATION="Global"
FWS_MIN_DEPTH=50
MAX_UNMODELLED_FRACTION=0.02
K_VALUES="1,2,3,4,5"
MOI_COVERAGE_THRESHOLD=10
MOI_NITER=1000
RESUME=1
