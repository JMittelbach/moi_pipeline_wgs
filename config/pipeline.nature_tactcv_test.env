# Real WGS smoke-test configuration for Nature Communications study
# doi:10.1038/s41467-024-54915-6, BioProject PRJNA1011501.
SAMPLES_TSV="test_data/nature_tactcv/samples.tsv"
RAW_DIR="test_data/nature_tactcv/fastq"
REFERENCE="raw_data/reference/GCF_000002765.6_genomic.fna"
TARGETS="raw_data/reference/pf4_global_maf001.targets.tsv.gz"
POPULATION_PANEL="raw_data/reference/pf4_population_panel.tsv.gz"
PROCESSED_DIR="test_runs/nature_tactcv/processed"
OUTPUT_DIR="test_runs/nature_tactcv/results"
PLOTS_DIR="plots"
THREADS=4
MAX_RAM_GB=48

TRIM_QUALITY=30
MIN_READ_LENGTH=75
ADAPTER_R1=""
ADAPTER_R2=""
MIN_MAPQ=30
MIN_BASEQ=20
MAX_DEPTH=100000

RUN_FREEBAYES=1
FREEBAYES_PLOIDY=1
FREEBAYES_MIN_ALT_COUNT=2
FREEBAYES_MIN_ALT_FRACTION=0.2
RUN_GATK4=1
GATK_PLOIDY=2
GATK_HETEROZYGOSITY=0.0029
GATK_INDEL_HETEROZYGOSITY=0.0017
GATK_MIN_ASSEMBLY_REGION_SIZE=100
GATK_MIN_BASE_QUALITY_SCORE=5
GATK_BASE_QUALITY_SCORE_THRESHOLD=12
GATK_STAND_CALL_CONF=30
GATK_JAVA_OPTIONS="-Xmx4g"
GATK_DISABLE_MAPPING_QUALITY_FILTER=1

POPULATION="Global"
FWS_MIN_DEPTH=50
MAX_UNMODELLED_FRACTION=0.02
K_VALUES="1,2,3,4,5"
MOI_COVERAGE_THRESHOLD=10
MOI_NITER=1000
RESUME=1
