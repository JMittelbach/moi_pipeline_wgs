# Simple sequential Plasmodium WGS + MOI/Fws pipeline.
# Paths are relative to the pipeline directory unless they start with '/'.

# Three-column tab-separated sample sheet: sample_id<TAB>R1<TAB>R2
SAMPLES_TSV="raw_data/samples.tsv"
RAW_DIR="raw_data/fastq"

# Plasmodium reference and the same frozen target/panel pair must be used.
# Default parasite reference: official P. falciparum 3D7 assembly
# GCF_000002765.6 (the NCBI package contains a *_genomic.fna file).
REFERENCE="raw_data/reference/GCF_000002765.6_genomic.fna"
TARGETS="raw_data/reference/pf4_global_maf001.targets.tsv.gz"
POPULATION_PANEL="raw_data/reference/pf4_population_panel.tsv.gz"

# Intermediate files, temporary files, quality control, and logs.
PROCESSED_DIR="processed"
# Final metrics, summary tables, and plots.
OUTPUT_DIR="results"
# Small human-readable SVG plots are written below OUTPUT_DIR by default.
PLOTS_DIR="plots"
THREADS=8

# Read trimming and mapping filters.
TRIM_QUALITY=30
MIN_READ_LENGTH=75
ADAPTER_R1=""
ADAPTER_R2=""
MIN_MAPQ=30
MIN_BASEQ=20
MAX_DEPTH=100000

# Fws and BinomMix/MOI parameters.
POPULATION="Global"
FWS_MIN_DEPTH=50
MAX_UNMODELLED_FRACTION=0.02
K_VALUES="1,2,3,4,5"
MOI_COVERAGE_THRESHOLD=10
MOI_NITER=1000

# Reuse completed files (1) or recompute every step (0).
RESUME=1
