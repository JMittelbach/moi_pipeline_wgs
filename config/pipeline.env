# Simple sequential Plasmodium WGS + MOI/Fws pipeline.
# Paths are relative to the pipeline directory unless they start with '/'.

# Three-column tab-separated sample sheet: sample_id<TAB>R1<TAB>R2
SAMPLES_TSV="data/samples.tsv"
RAW_DIR="data"

# Plasmodium reference and the same frozen target/panel pair must be used.
# Default parasite reference: official P. falciparum 3D7 assembly
# GCF_000002765.6 (the NCBI package contains a *_genomic.fna file).
REFERENCE="raw_data/reference/GCF_000002765.6_genomic.fna"
TARGETS="raw_data/reference/pf4_global_maf001.targets.tsv.gz"
POPULATION_PANEL="raw_data/reference/pf4_population_panel.tsv.gz"

# Intermediate files, temporary files, quality control, and logs.
PROCESSED_DIR="processed"
# Final metrics, summary tables, and plots.
OUTPUT_DIR="results"
# Small human-readable SVG plots are written below OUTPUT_DIR by default.
PLOTS_DIR="plots"
THREADS=8
# Hard pipeline ceiling. Values above 48 are rejected; Linux steps also get a
# per-process virtual-memory limit. Keep GATK_JAVA_OPTIONS below this ceiling.
MAX_RAM_GB=48

# Read trimming and mapping filters.
TRIM_QUALITY=30
MIN_READ_LENGTH=75
ADAPTER_R1=""
ADAPTER_R2=""
MIN_MAPQ=30
MIN_BASEQ=20
MAX_DEPTH=100000

# Optional whole-genome variant calling. Set either RUN_* value to 1 to write
# the corresponding VCF after duplicate removal.
RUN_FREEBAYES=0
FREEBAYES_PLOIDY=1
FREEBAYES_MIN_ALT_COUNT=2
FREEBAYES_MIN_ALT_FRACTION=0.2

# Optional GATK4 HaplotypeCaller -> gVCF -> GenotypeGVCFs branch.
RUN_GATK4=0
GATK_PLOIDY=2
GATK_HETEROZYGOSITY=0.0029
GATK_INDEL_HETEROZYGOSITY=0.0017
GATK_MIN_ASSEMBLY_REGION_SIZE=100
GATK_MIN_BASE_QUALITY_SCORE=5
GATK_BASE_QUALITY_SCORE_THRESHOLD=12
GATK_STAND_CALL_CONF=30
GATK_JAVA_OPTIONS="-Xmx4g"
GATK_DISABLE_MAPPING_QUALITY_FILTER=1

# Fws and BinomMix/MOI parameters.
POPULATION="Global"
FWS_MIN_DEPTH=50
MAX_UNMODELLED_FRACTION=0.02
K_VALUES="1,2,3,4,5"
MOI_COVERAGE_THRESHOLD=10
MOI_NITER=1000

# Reuse completed files (1) or recompute every step (0).
RESUME=1
